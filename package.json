{
  "name": "tricore-ai-assistant-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/worker run dev",
    "db:migrate:local": "npm --prefix apps/worker run db:migrate:local",
    "db:seed:local": "npm --prefix apps/worker run db:seed:local",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.5.24",
    "@cloudflare/workers-types": "5.20261115.1",
    "@vitest/runner": "2.1.4",
    "@vitest/snapshot": "2.1.4",
    "eslint": "9.14.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vitest": "2.1.4",
    "wrangler": "4.162.0"
  }
}
