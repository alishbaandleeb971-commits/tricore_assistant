  },
  "dependencies": {
    "@sentry/cloudflare": "8.38.0",
    "@tricore/shared": "*",
    "drizzle-orm": "0.36.1",
    "hono": "4.6.9",
    "jose": "5.9.6",
    "libphonenumber-js": "1.11.12",
    "uuidv7": "1.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "drizzle-kit": "0.28.1",
    "typescript": "5.6.3",
    "wrangler": "4.162.0"
  }
}
